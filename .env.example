# Disclosure Drift — example environment file.
# Copy to .env and edit. .env is git-ignored; .env.example is tracked and must
# never contain a real address, key, or token.
#
# These are the ONLY environment variables the package recognizes. Any other
# DISCLOSURE_DRIFT_* variable raises an error, so typos never pass silently.
# Cohort windows, maturity gates, and seeds are frozen research definitions and
# cannot be overridden here.

# Recognized secret. Resolved on demand only; never logged or printed.
# Required before Milestone 2 SEC ingestion; optional in Milestone 1.
DISCLOSURE_DRIFT_SEC_USER_AGENT="Example Researcher researcher@example.com"

# Optional machine-specific overrides. May be absolute paths.
DISCLOSURE_DRIFT_DATA_ROOT=./data
DISCLOSURE_DRIFT_LOG_DIR=./logs

# Optional logging overrides.
DISCLOSURE_DRIFT_LOG_LEVEL=INFO
DISCLOSURE_DRIFT_LOG_TO_FILE=false

# Optional alternate configuration file.
# DISCLOSURE_DRIFT_CONFIG=./configs/project.yaml
