.DS_Store
.env
.env.*
!.env.example

# Virtual environments. CI builds its environments under RUNNER_TEMP, outside the
# checkout; these entries are defense in depth, so an environment created inside
# the repository can never be enumerated by the secret or hygiene gates.
.venv/
.venv-core/
.venv-sec/
venv/
__pycache__/
*.py[cod]

.pytest_cache/
.ruff_cache/
.mypy_cache/
# mypy daemon status file, written by `make typecheck-fast` into the working directory.
# The daemon is a local convenience only; `mypy src` remains the acceptance gate.
.dmypy.json
.coverage
htmlcov/

# Data governance (Decision 009): nothing under data/ is tracked except its README.
data/**
!data/
!data/README.md

# Operational catalog, releases, and transfer artifacts must never be tracked.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.parquet
*.part

*.log
logs/

build/
dist/
*.egg-info/

.idea/
.vscode/

# Milestone 3 reserved operational-evidence path (M3-L11, Decision 028 section 11).
# Completed operational evidence lives in an owner-controlled private root OUTSIDE this
# repository. This entry is layer 1 of three and only stops accidental staging; because an
# ignored path is invisible to `git ls-files --exclude-standard`, scripts/check_repo_hygiene.py
# refuses this exact path explicitly (layer 2), and the M3 evidence-root validator refuses any
# root inside, equal to, or containing the checkout (layer 3).
/.m3-private-evidence
